# ── Credenciales. NUNCA commitear ───────────────────────────────────────────
.env
.env.*
!.env.example
*.key
credentials.json
token.json

# Configuración local: mapea tu vida privada (bancos, trámites, postulaciones).
# Ver config/descartados.local.yml.example para la plantilla pública.
config/*.local.yml

# Extensiones locales del pipeline, con el mismo criterio que los .local.yml
# de arriba: son de quien corre el pipeline, no del repositorio.
pipeline/*.local.py

# ── Salidas locales ──────────────────────────────────────────────────────────
# Cualquier volcado de depuración que no deba publicarse (ver spec.md §7).
salidas_privadas/
*.privado.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# ── Sistema ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

